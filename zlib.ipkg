package zlib

authors    = "Matthew Mosior"
brief      = "Idris2 bindings to zlib"
license    = "BSD-3 Clause"
version    = 0.1.0
sourcedir  = "src"
depends    = base
           , array
           , elab-util
           , elin
           , posix
           , ref1
modules    = Codec.Compression.Zlib.Checksum
           , Codec.Compression.Zlib.Compress
           , Codec.Compression.Zlib.Decompress
           , Codec.Compression.Zlib.Internal
           , Codec.Compression.Zlib.Proofs
           , Codec.Compression.Zlib.Stream
           , Codec.Compression.Zlib.Types
           , Codec.Compression.Zlib.Utilities
           , Codec.Compression.Zlib
           , System.Zlib.Constant
           , System.Zlib.Error
           , System.Zlib.Raw
           , System.Zlib.Types
prebuild   = "make -C support"
preinstall = "make -C support install"
